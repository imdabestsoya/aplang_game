{
  "name": "the-weight",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run docs:check && npm run validate:content && npm run validate:assets && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest --config vitest.config.ts",
    "test:routes": "vitest run --config vitest.routes.config.ts",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test -- --run && npm run test:routes && npm run build",
    "docs:symbolism": "node scripts/generate-symbolism.mjs",
    "docs:check": "node scripts/generate-symbolism.mjs --check",
    "test:content": "vitest run --config vitest.config.ts tests/unit/narrative.test.ts",
    "play": "npm run build && vite preview --host 127.0.0.1",
    "validate:content": "npm run test:content && node --experimental-strip-types scripts/validate-trail.mjs",
    "validate:assets": "node --experimental-strip-types scripts/validate-trail.mjs --assets"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
